        "editorial-typography-director",
        "motion-web-director"
      ],
      "reviewers": [
        "editorial-storyteller",
        "experience-designer",
        "research-synthesist",
        "creative-director"
      ],
      "arbiter": "creative-director",
      "exit_gate": "art-direction-ready"
    },
    {
      "stage_id": "production",
      "title": "Landing production",
      "tasks": [
        {
          "task_id": "ui-production",
          "agent_id": "flame-ui-composer",
          "sizing_points": 5
