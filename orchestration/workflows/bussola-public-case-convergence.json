    "min_average_score": 4.5,
    "blockers": 0,
    "unresolved_issues": 0,
    "required_viewports": [
      1440,
      390,
      320
    ],
    "required_checks": [
      "narrative",
      "content_design",
      "experience",
      "visual_authorship",
      "responsive",
      "product_evidence",
      "accessibility",
      "implementation_fidelity",
      "provenance_readiness"
    ]
  },
  "debate_protocol_ref": "orchestration/convergence-issue.schema.json",
  "observability_events": [
    "convergence_issue_created",
    "convergence_issue_owner_responded",
    "convergence_issue_arbitrated",
