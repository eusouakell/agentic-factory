{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eusouakell/agentic-factory/quality/visual-evidence.schema.json",
  "title": "Visual QA evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_ref", "required_viewports", "required_sections", "captures"],
  "properties": {
    "candidate_ref": {"type": "string", "minLength": 1},
    "required_viewports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "required_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "viewport_width",
          "section_id",
          "dom_anchor",
          "artifact_ref",
          "content_sha256",
          "observed_heading",
          "reviewer_id",
          "review_run_id",
          "status"
        ],
        "properties": {
          "viewport_width": {"type": "integer", "minimum": 1},
          "section_id": {"type": "string", "minLength": 1},
          "dom_anchor": {"type": "string", "minLength": 1},
          "artifact_ref": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "observed_heading": {"type": "string", "minLength": 1},
          "reviewer_id": {"type": "string", "minLength": 1},
          "review_run_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]}
        }
      }
    }
  }
}
